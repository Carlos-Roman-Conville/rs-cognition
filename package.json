{
  "name": "@rex/cognition",
  "version": "0.1.0",
  "description": "The cognition engine: perception, needs, beliefs and memory, action selection and learning. Generates an organism's intentions; never decides whether an attempt succeeds. A pure function of its inputs plus kernel streams; no game imports.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src", "personality", "data", "kernel.json", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "bench": "node --experimental-strip-types bench/hungry-pair/report.ts",
    "codex-check": "node --experimental-strip-types scripts/codex-fingerprint.ts --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rex/kernel": "git+file:///E:/backups/reality-sim/git/kernel.git#v0.1.1"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
